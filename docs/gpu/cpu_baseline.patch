+def recover_children_on_extensions(points, labels, primary, roots, *, parent_ids, d_bar,
+    mesh_context, excluded_mask, analysis_to_mesh, primary_top_reference, gravity,
+    max_root_order=3, max_paths=None, cooperate=None):
